diff --git a/src/lib/notify/paymentReceiptDeliver.ts b/src/lib/notify/paymentReceiptDeliver.ts
new file mode 100644
index 0000000..623c95e
--- /dev/null
+++ b/src/lib/notify/paymentReceiptDeliver.ts
@@ -0,0 +1,123 @@
+import { connectDB } from "@/lib/mongodb";
+import { notifyBookingPayment } from "@/lib/notify/bookingNotify";
+import { gstBreakdownInclusive } from "@/lib/gst";
+import Transaction from "@/models/Transaction";
+import Booking from "@/models/Booking";
+
+function env(name: string) {
+  return String(process.env[name] || "").trim();
+}
+
+export type DeliverReceiptInput = {
+  bookingId: string;
+  bookingMongoId?: string;
+  email?: string;
+  phone?: string;
+  amount?: number;
+};
+
+async function sendDetailedEmail(opts: {
+  to: string;
+  bookingId: string;
+  riderName: string;
+  amount: number;
+  paymentMethod: string;
+  invoiceNumber: string;
+  transactionId: string;
+  gst: ReturnType<typeof gstBreakdownInclusive>;
+}) {
+  const resend = env("RESEND_API_KEY");
+  const from = env("NOTIFY_FROM_EMAIL") || "EVUDDY <noreply@evuddy.com>";
+  if (!resend) return false;
+  const html = `<div style="font-family:Arial,sans-serif;max-width:560px;color:#0f172a">
+<p style="color:#18B368;font-weight:800;letter-spacing:.12em;font-size:11px">EVUDDY PAYMENT RECEIPT</p>
+<h1 style="font-size:22px">₹${opts.amount.toLocaleString("en-IN")} received</h1>
+<table style="width:100%;border-collapse:collapse">
+<tr><td style="padding:8px 0;font-weight:700;color:#64748b">Booking</td><td>${opts.bookingId}</td></tr>
+<tr><td style="padding:8px 0;font-weight:700;color:#64748b">Rider</td><td>${opts.riderName}</td></tr>
+<tr><td style="padding:8px 0;font-weight:700;color:#64748b">Method</td><td>${opts.paymentMethod}</td></tr>
+<tr><td style="padding:8px 0;font-weight:700;color:#64748b">Invoice</td><td>${opts.invoiceNumber || "—"}</td></tr>
+<tr><td style="padding:8px 0;font-weight:700;color:#64748b">Transaction</td><td>${opts.transactionId || "—"}</td></tr>
+<tr><td style="padding:8px 0;font-weight:700;color:#64748b">Taxable</td><td>₹${opts.gst.taxableAmount.toFixed(2)}</td></tr>
+<tr><td style="padding:8px 0;font-weight:700;color:#64748b">GST (5%)</td><td>₹${opts.gst.gstAmount.toFixed(2)}</td></tr>
+</table>
+<p style="font-size:12px;color:#64748b;margin-top:20px">Same record as evuddy.com admin CRM · helpdesk@kebuone.in</p>
+</div>`;
+  try {
+    const res = await fetch("https://api.resend.com/emails", {
+      method: "POST",
+      headers: {
+        Authorization: `Bearer ${resend}`,
+        "Content-Type": "application/json",
+      },
+      body: JSON.stringify({
+        from,
+        to: [opts.to],
+        subject: `EVUDDY receipt · ${opts.bookingId} · ₹${opts.amount}`,
+        html,
+      }),
+    });
+    return res.ok;
+  } catch {
+    return false;
+  }
+}
+
+export async function deliverPaymentReceipt(input: DeliverReceiptInput) {
+  await connectDB();
+  const bookingId = String(input.bookingId || "").trim();
+  const txnRaw = bookingId
+    ? await Transaction.findOne({ bookingId }).sort({ createdAt: -1 }).lean()
+    : null;
+  const txn = txnRaw && !Array.isArray(txnRaw) ? txnRaw : null;
+  const bookingRaw = bookingId
+    ? await Booking.findOne({ bookingId }).select("userName userPhone userEmail").lean()
+    : null;
+  const booking = bookingRaw && !Array.isArray(bookingRaw) ? bookingRaw : null;
+
+  const amount = Number(input.amount || txn?.amount || 0);
+  const riderName = String(booking?.userName || "Rider");
+  const riderPhone = String(input.phone || booking?.userPhone || "").slice(-10);
+  const riderEmail = String(input.email || booking?.userEmail || "").trim();
+  const paymentMethod = String(txn?.paymentMethod || "Razorpay");
+  const invoiceNumber = String(txn?.invoiceNumber || "");
+  const transactionId = String(txn?.transactionId || "");
+  const gst = gstBreakdownInclusive(amount);
+
+  const channels: string[] = [];
+
+  if (riderEmail) {
+    const ok = await sendDetailedEmail({
+      to: riderEmail,
+      bookingId,
+      riderName,
+      amount,
+      paymentMethod,
+      invoiceNumber,
+      transactionId,
+      gst,
+    });
+    if (ok) channels.push("email");
+  }
+
+  const notify = await notifyBookingPayment({
+    bookingId,
+    riderName,
+    riderPhone,
+    riderEmail,
+    amount,
+    pendingAmount: 0,
+    paymentStatus: "Paid",
+    paymentMethod: paymentMethod.includes("Wallet") ? "Wallet" : "Razorpay",
+    invoiceNumber,
+  });
+  if (notify.sms) channels.push("SMS");
+  if (notify.email && !channels.includes("email")) channels.push("email");
+
+  return {
+    success: channels.length > 0,
+    channels: [...new Set(channels)],
+    emailSent: channels.includes("email"),
+    smsSent: channels.includes("SMS"),
+  };
+}
diff --git a/src/lib/notify/rentalEndReminder.ts b/src/lib/notify/rentalEndReminder.ts
new file mode 100644
index 0000000..13f96fa
--- /dev/null
+++ b/src/lib/notify/rentalEndReminder.ts
@@ -0,0 +1,105 @@
+import { notifyOpsAlert } from "@/lib/notify/opsAlert";
+
+function env(name: string) {
+  return String(process.env[name] || "").trim();
+}
+
+export type RentalEndReminderInput = {
+  bookingId: string;
+  riderName?: string;
+  riderPhone?: string;
+  riderEmail?: string;
+  endsAtIso?: string;
+  duration?: string;
+  units?: number;
+  leadMinutes?: number;
+};
+
+function formatIst(iso: string) {
+  try {
+    return new Date(iso).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" });
+  } catch {
+    return iso;
+  }
+}
+
+async function sendSms(phone10: string, message: string) {
+  const fast2sms = env("FAST2SMS_API_KEY");
+  if (fast2sms) {
+    try {
+      const res = await fetch("https://www.fast2sms.com/dev/bulkV2", {
+        method: "POST",
+        headers: {
+          authorization: fast2sms,
+          "Content-Type": "application/json",
+        },
+        body: JSON.stringify({
+          route: "q",
+          message: message.slice(0, 300),
+          language: "english",
+          numbers: phone10,
+        }),
+      });
+      if (res.ok) return true;
+    } catch {
+      /* fall through */
+    }
+  }
+  const msg91 = env("MSG91_AUTH_KEY");
+  if (msg91) {
+    try {
+      const res = await fetch(
+        `https://control.msg91.com/api/sendhttp.php?authkey=${encodeURIComponent(msg91)}&mobiles=91${phone10}&message=${encodeURIComponent(message.slice(0, 300))}&sender=EVUDDY&route=4&country=91`,
+        { method: "GET" }
+      );
+      if (res.ok) return true;
+    } catch {
+      /* fall through */
+    }
+  }
+  return false;
+}
+
+async function sendEmail(to: string, subject: string, text: string) {
+  const resend = env("RESEND_API_KEY");
+  const from = env("NOTIFY_FROM_EMAIL") || "EVUDDY <noreply@evuddy.com>";
+  if (!to || !resend) return false;
+  try {
+    const res = await fetch("https://api.resend.com/emails", {
+      method: "POST",
+      headers: {
+        Authorization: `Bearer ${resend}`,
+        "Content-Type": "application/json",
+      },
+      body: JSON.stringify({ from, to: [to], subject, text }),
+    });
+    return res.ok;
+  } catch {
+    return false;
+  }
+}
+
+export async function notifyRentalEndReminder(input: RentalEndReminderInput) {
+  const ends = input.endsAtIso ? formatIst(input.endsAtIso) : "soon";
+  const plan =
+    input.duration && input.units
+      ? `${input.duration} (${input.units} units)`
+      : input.duration || "rental";
+  const smsText = `EVUDDY ALERT: Booking ${input.bookingId} (${plan}) ends around ${ends}. Return the scooter on time. Help: 8726006512`;
+  const emailText = `Hello ${input.riderName || "rider"},\n\nYour EVUDDY booking ${input.bookingId} (${plan}) is scheduled to end around ${ends} (IST).\n\nPlease plan your return to the hub.\n\n— EVUDDY\nhelpdesk@kebuone.in · +91 8726006512`;
+
+  const phone = String(input.riderPhone || "").replace(/\D/g, "").slice(-10);
+  const email = String(input.riderEmail || "").trim();
+
+  const [smsSent, emailSent] = await Promise.all([
+    phone.length === 10 ? sendSms(phone, smsText) : Promise.resolve(false),
+    email ? sendEmail(email, `EVUDDY · ${input.bookingId} ending soon`, emailText) : Promise.resolve(false),
+  ]);
+
+  await notifyOpsAlert(
+    `Booking ${input.bookingId} · ~${input.leadMinutes || 60} min to end`,
+    `${plan} · ${input.riderName || "rider"} · +91${phone || "—"} · ends ${ends}`
+  );
+
+  return { emailSent, smsSent, email: emailSent, sms: smsSent };
+}
diff --git a/src/lib/riderSafetyOps.ts b/src/lib/riderSafetyOps.ts
new file mode 100644
index 0000000..869ba1a
--- /dev/null
+++ b/src/lib/riderSafetyOps.ts
@@ -0,0 +1,91 @@
+import { connectDB } from "@/lib/mongodb";
+import { NOT_DELETED_FILTER } from "@/lib/notDeleted";
+import { applyHubScope, resolveHubScope } from "@/lib/staffHubScope";
+import type { AdminSessionInfo } from "@/lib/adminAuth";
+import Booking from "@/models/Booking";
+
+export type RiderSafetyAlertLevel = "ok" | "warning" | "siren";
+
+export type RiderSafetyRow = {
+  bookingId: string;
+  userName: string;
+  userPhone: string;
+  vehicleId: string;
+  rentalMode: string;
+  rideStatus: string;
+  rentalEndDate: string;
+  minutesUntilEnd: number;
+  alertLevel: RiderSafetyAlertLevel;
+  riderPhoneLat: number | null;
+  riderPhoneLng: number | null;
+  riderPhoneUpdatedAt: string | null;
+  hasPhoneGps: boolean;
+};
+
+export function alertLevelForMinutes(minutes: number): RiderSafetyAlertLevel {
+  if (minutes <= 60) return "siren";
+  if (minutes <= 180) return "warning";
+  return "ok";
+}
+
+export function minutesUntil(isoOrDate: Date | string | undefined | null) {
+  if (!isoOrDate) return 99999;
+  const end = isoOrDate instanceof Date ? isoOrDate : new Date(isoOrDate);
+  if (Number.isNaN(end.getTime())) return 99999;
+  return Math.max(0, Math.round((end.getTime() - Date.now()) / 60000));
+}
+
+export async function listRiderSafetyForAdmin(session: AdminSessionInfo) {
+  await connectDB();
+  const hubCodes = await resolveHubScope(session);
+  const filter = applyHubScope(
+    {
+      ...NOT_DELETED_FILTER,
+      rideStatus: { $in: ["In Ride", "Ready For Pickup", "Reserved"] },
+    },
+    hubCodes,
+    ["currentHub", "startHub"]
+  );
+
+  const rows = await Booking.find(filter)
+    .select(
+      "bookingId userName userPhone vehicleId rentalMode rideStatus rentalEndDate riderPhoneLat riderPhoneLng riderPhoneUpdatedAt"
+    )
+    .sort({ rentalEndDate: 1 })
+    .limit(50)
+    .lean()
+    .maxTimeMS(4000);
+
+  const mapped: RiderSafetyRow[] = rows.map((row) => {
+    const lat = Number(row.riderPhoneLat);
+    const lng = Number(row.riderPhoneLng);
+    const hasPhoneGps =
+      Number.isFinite(lat) &&
+      Number.isFinite(lng) &&
+      lat !== 0 &&
+      lng !== 0;
+    const minutes = minutesUntil(row.rentalEndDate);
+    return {
+      bookingId: String(row.bookingId || ""),
+      userName: String(row.userName || ""),
+      userPhone: String(row.userPhone || ""),
+      vehicleId: String(row.vehicleId || ""),
+      rentalMode: String(row.rentalMode || ""),
+      rideStatus: String(row.rideStatus || ""),
+      rentalEndDate: row.rentalEndDate
+        ? new Date(row.rentalEndDate).toISOString()
+        : "",
+      minutesUntilEnd: minutes,
+      alertLevel: alertLevelForMinutes(minutes),
+      riderPhoneLat: hasPhoneGps ? lat : null,
+      riderPhoneLng: hasPhoneGps ? lng : null,
+      riderPhoneUpdatedAt: row.riderPhoneUpdatedAt
+        ? new Date(row.riderPhoneUpdatedAt).toISOString()
+        : null,
+      hasPhoneGps,
+    };
+  });
+
+  mapped.sort((a, b) => a.minutesUntilEnd - b.minutesUntilEnd);
+  return mapped;
+}
