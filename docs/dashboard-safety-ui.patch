+"use client";
+
+import type { RiderSafetyRow } from "@/lib/riderSafetyOps";
+
+type Props = {
+  rows: RiderSafetyRow[];
+  onOpenIot?: () => void;
+};
+
+function formatCountdown(minutes: number, overdueStale: boolean) {
+  if (overdueStale) return "Overdue";
+  if (minutes >= 24 * 60) {
+    return `${Math.floor(minutes / (60 * 24))}d ${Math.floor((minutes % (60 * 24)) / 60)}h`;
+  }
+  const h = Math.floor(minutes / 60);
+  const m = minutes % 60;
+  if (h > 0) return `${h}h ${m}m`;
+  return `${m}m`;
+}
+
+function RiderAvatar({ row }: { row: RiderSafetyRow }) {
+  const name = row.userName || "Rider";
+  const initial = name.trim().charAt(0).toUpperCase() || "?";
+  if (row.profilePhotoUrl) {
+    return (
+      <img
+        src={row.profilePhotoUrl}
+        alt=""
+        className="h-14 w-14 shrink-0 rounded-full border-2 border-white object-cover shadow-sm"
+      />
+    );
+  }
+  return (
+    <div className="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-white bg-emerald-100 text-lg font-extrabold text-emerald-900 shadow-sm">
+      {initial}
+    </div>
+  );
+}
+
+function RowCard({ row, onOpenIot }: { row: RiderSafetyRow; onOpenIot?: () => void }) {
+  const siren = row.alertLevel === "siren" && !row.overdueStale;
+  const warn = row.alertLevel === "warning";
+  const stale = row.overdueStale;
+
+  const shell = stale
+    ? "border-slate-300 bg-slate-50"
+    : siren
+    ? "border-red-400 bg-gradient-to-br from-red-800 to-orange-600 text-white shadow-md"
+    : warn
+    ? "border-amber-300 bg-amber-50"
+    : "border-emerald-100 bg-white shadow-sm";
+
+  const label = stale
+    ? "Needs CRM cleanup"
+    : siren
+    ? "SIREN · return soon"
+    : warn
+    ? "Ending within 3 hours"
+    : "Trip safety";
+
+  return (
+    <div className={`rounded-2xl border p-4 ${shell}`}>
+      <div className="flex gap-4">
+        <RiderAvatar row={row} />
+        <div className="min-w-0 flex-1">
+          <div className="flex flex-wrap items-start justify-between gap-2">
+            <div className="min-w-0">
+              <p
+                className={`text-[11px] font-extrabold uppercase tracking-wide ${
+                  siren ? "text-white/90" : stale ? "text-slate-500" : "text-red-600"
+                }`}
+              >
+                {siren ? "🚨 " : warn ? "⚠️ " : stale ? "⏸ " : ""}
+                {label}
+              </p>
+              <p
+                className={`truncate text-lg font-extrabold ${
+                  siren ? "text-white" : "text-slate-900"
+                }`}
+              >
+                {row.userName || "Rider"}
+              </p>
+              <p
+                className={`text-sm ${siren ? "text-white/90" : "text-slate-600"}`}
+              >
+                {row.bookingId} · {row.rentalMode} · {row.vehicleId || "—"}
+              </p>
+              <p className={`text-xs ${siren ? "text-white/80" : "text-slate-500"}`}>
+                +91{row.userPhone} · {row.rideStatus}
+              </p>
+            </div>
+            <div className="text-right">
+              <p
+                className={`text-2xl font-black tabular-nums leading-none ${
+                  siren ? "text-white" : stale ? "text-slate-500" : "text-slate-900"
+                }`}
+              >
+                {formatCountdown(row.minutesUntilEnd, row.overdueStale)}
+              </p>
+              <p
+                className={`mt-1 text-[11px] font-semibold ${
+                  siren ? "text-white/80" : "text-slate-500"
+                }`}
+              >
+                until rental end
+              </p>
+            </div>
+          </div>
+          <div
+            className={`mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-semibold ${
+              siren ? "text-white/90" : "text-slate-600"
+            }`}
+          >
+            <span>
+              {row.hasPhoneGps
+                ? `📍 Live GPS ${row.riderPhoneLat?.toFixed(5)}, ${row.riderPhoneLng?.toFixed(5)}`
+                : "📍 Phone GPS waiting (rider app)"}
+            </span>
+            {row.riderPhoneUpdatedAt ? (
+              <span>
+                Updated{" "}
+                {new Date(row.riderPhoneUpdatedAt).toLocaleTimeString("en-IN", {
+                  timeZone: "Asia/Kolkata",
+                })}{" "}
+                IST
+              </span>
+            ) : null}
+            {onOpenIot && row.hasPhoneGps ? (
+              <button
+                type="button"
+                className={`underline ${siren ? "text-white" : "text-emerald-700"}`}
+                onClick={onOpenIot}
+              >
+                Open IoT map
+              </button>
+            ) : null}
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export default function RiderSafetyBoard({ rows, onOpenIot }: Props) {
+  if (!rows.length) {
+    return (
+      <div className="rounded-2xl border border-dashed border-slate-200 bg-white p-8 text-center text-sm text-slate-600">
+        No active rider trips. When riders book and ride in the app, countdown and phone GPS appear here
+        (newest urgent trips first).
+      </div>
+    );
+  }
+
+  const live = rows.filter((r) => !r.overdueStale);
+  const stale = rows.filter((r) => r.overdueStale);
+
+  return (
+    <div className="space-y-6">
+      {live.length > 0 ? (
+        <div className="space-y-3">
+          <p className="text-xs font-extrabold uppercase tracking-wide text-emerald-800">
+            Active trips · {live.length}
+          </p>
+          {live.slice(0, 15).map((row) => (
+            <RowCard key={row.bookingId} row={row} onOpenIot={onOpenIot} />
+          ))}
+        </div>
+      ) : null}
+      {stale.length > 0 ? (
+        <div className="space-y-3 border-t border-slate-200 pt-4">
+          <p className="text-xs font-extrabold uppercase tracking-wide text-slate-500">
+            Overdue in CRM · complete or cancel · {stale.length}
+          </p>
+          {stale.slice(0, 8).map((row) => (
+            <RowCard key={`stale-${row.bookingId}`} row={row} onOpenIot={onOpenIot} />
+          ))}
+        </div>
+      ) : null}
+    </div>
+  );
+}
